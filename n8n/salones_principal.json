      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  (SELECT COUNT(*) FROM buffer_mensajes\n     WHERE lead_id = $1 AND consumido_en IS NULL\n       AND recibido_en > (SELECT recibido_en FROM buffer_mensajes WHERE msg_id = $2)\n  ) AS mas_nuevos,\n  (SELECT string_agg(texto, chr(10) ORDER BY recibido_en)\n     FROM buffer_mensajes WHERE lead_id = $1 AND consumido_en IS NULL\n  ) AS chats,\n  (SELECT COUNT(*) FROM buffer_mensajes\n     WHERE lead_id = $1 AND consumido_en IS NULL) AS cuantos;",
        "options": {
