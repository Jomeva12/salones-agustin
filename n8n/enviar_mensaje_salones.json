    {
      "parameters": {
        "jsCode": "// 1. Obtenemos los datos del Webhook (Nodo inicial)\nconst webhook = $(\"When Executed by Another Workflow\").first().json; \n\n// 2. Obtenemos TODAS las plantillas del nodo \"Get row(s)\"\nconst plantillas = $(\"Get row(s)\").all(); \n\nconst resultados = [];\n// El drive de cada cuenta de Kommo vive en un host distinto: esta es\n// drive-c, y aqui decia drive-g porque el subflujo se copio de otra\n// cuenta. Con el dominio equivocado TODA imagen se descartaba en\n// silencio. Se acepta cualquier drive de Kommo para que no vuelva a\n// romperse si la cuenta cambia de host.\nconst DRIVE_KOMMO = /^https:\\/\\/drive-[a-z0-9-]+\\.kommo\\.com\\//i;\n\nconst PATRON_TOOL_LEAK = /Calling\\s+\\w+\\s*[:.]|default_api\\s*[:.]|tool_code|functions?\\.\\w+\\s*\\(/i;\nconst MENSAJE_SEGURO = 'Permíteme un momento, en seguida te confirmo esa información. 🙌';\n\n// Extrae el valor de un campo string del texto SIN depender de JSON.parse.\n// Recupera el mensaje real aunque el JSON esté roto/truncado.\nfunction extraerCampo(t, campo) {\n  const re = new RegExp('\"' + campo + '\"\\\\s*:\\\\s*\"((?:\\\\\\\\.|[^\"\\\\\\\\])*)\"');\n  const m = t.match(re);\n  if (!m) return null;\n  try { return JSON.parse('\"' + m[1] + '\"'); } catch (e) { return m[1]; }\n}\n\nfunction blindarTexto(texto, i) {\n  if (typeof texto !== 'string') return texto;\n  let t = texto.trim()\n    .replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/```\\s*$/i, '').trim();\n\n  // fuga de tool-call: no hay mensaje real que rescatar\n  if (PATRON_TOOL_LEAK.test(t)) return MENSAJE_SEGURO;\n\n  // ¿parece payload crudo del agente?\n  const pareceAgente = t.startsWith('{') &&\n    /\"(parte1|parte2|parte3|parte4|cadena_pensamiento|datos_capturados|bot_id|respuesta|quiere_cita)\"/i.test(t);\n  if (!pareceAgente) return texto; // texto normal → tal cual\n\n  // 1) parse completo\n  try {\n    const obj = JSON.parse(t.substring(t.indexOf('{'), t.lastIndexOf('}') + 1));\n    const cand = obj['parte' + i] || obj.parte1 || obj.respuesta || obj.parte2;\n    if (typeof cand === 'string' && cand.trim() && !cand.trim().startsWith('{')) return cand.trim();\n  } catch (e) { /* sigue al rescate por regex */ }\n\n  // 2) rescate por REGEX (JSON roto) → recupera el mensaje REAL, no un genérico\n  for (const campo of ['parte' + i, 'parte1', 'respuesta', 'parte2']) {\n    const val = extraerCampo(t, campo);\n    if (val && val.trim() && !val.trim().startsWith('{')) return val.trim();\n  }\n\n  // 3) sin mensaje rescatable (output vacío/basura) → seguro, nunca JSON crudo\n  return MENSAJE_SEGURO;\n}\n\n// Las imagenes llegan como JSON porque la entrada del subflujo es plana.\n// Si viene rota o vacia se sigue sin fotos: el texto es lo que no puede\n// faltar.\nlet imagenes = [];\ntry {\n    const crudo = webhook.imagenes;\n    imagenes = Array.isArray(crudo) ? crudo : JSON.parse(crudo || '[]');\n    if (!Array.isArray(imagenes)) imagenes = [];\n} catch (e) { imagenes = []; }\n\n// 3. Validamos disponibilidad según 'cuantas_partes' del webhook\nif (plantillas.length < webhook.cuantas_partes) {\n    throw new Error(`Insuficientes bots disponibles. Requeridos: ${webhook.cuantas_partes}, Disponibles: ${plantillas.length}`);\n}\n\n// 4. Mapeamos las partes del mensaje a las plantillas\nfor (let i = 1; i <= webhook.cuantas_partes; i++) {\n    let texto = blindarTexto(webhook[`parte${i}`], i);\n    \n    if (texto && texto.trim() !== \"\" && texto !== \"vacio\") {\n        // Asignamos la plantilla según el índice\n        const plantillaAsignada = plantillas[i - 1].json;\n\n        let item = {\n            texto_a_enviar: texto,\n            lead_id: webhook.lead_id,\n            parte_numero: i,\n            id_db: plantillaAsignada.id, \n            id_plantilla_kommo: plantillaAsignada.id_plantilla,\n            nombre_bot: plantillaAsignada.nombre_bot,\n            en_salesbot: plantillaAsignada.en_salesbot\n        };\n\n        // Una imagen por parte. Kommo adjunta UNA por plantilla, asi que\n        // tres laminas son tres mensajes; `imagenes` viene alineado con las\n        // partes y lo arma elegir_lamina. `imagen_url` se sigue aceptando\n        // para no romper a quien todavia mande solo una.\n        const dePart = imagenes[i - 1] || (i === 1 ? webhook.imagen_url : '');\n        if (dePart) {\n            if (DRIVE_KOMMO.test(dePart)) {\n                item.url_imagen = dePart;\n            } else {\n                console.log(\"URL bloqueada: \" + dePart);\n            }\n        }\n\n        resultados.push(item);\n    }\n}\n\nreturn resultados;"
      },
      "type": "n8n-nodes-base.code",
