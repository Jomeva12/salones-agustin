            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "aee05f2c-044c-4c00-aa8e-76d5231004d7",
              "leftValue": "={{ [112261039, 112261047, 112261051, 112261055, 142, 143].includes($json.etapa_id) === false && String($json.campos['Stop IA']) !== 'true' }}",
              "rightValue": "true",
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
