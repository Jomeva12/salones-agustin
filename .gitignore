# La base y su volcado en JSON son DATOS, no codigo: llevan la cuenta
# bancaria del negocio, el numero privado del Lic. y los hashes de las
# contrasenas. El seed se regenera desde la base con exportar_seed.py.
backend/db/seed/
backend/db/*.db
backend/db/*.db-wal
backend/db/*.db-shm
node_modules/
.DS_Store

# Respaldos de la base: son datos, y pesan.
backend/db/respaldos/
para-subir/

# La API key de n8n. Vive en un archivo para poder usarla en comandos con
# $(cat .n8n_key), sin que el valor quede escrito en ningun lado.
.n8n_key
.kommo_token

# Cualquier archivo con credenciales que caiga en esta carpeta. El repositorio
# es PUBLICO: un `git add -A` distraido publica tokens vivos para siempre.
.env
.env.*
*variables*.txt
*credencial*
*secret*
*token*.txt

# Las laminas de los paquetes: son arte del cliente, pesan, y su sitio es el
# Drive de Kommo, no un repositorio publico. Lo que si se versiona es el
# mapa.json que dice que lamina es de que paquete.
imagenes/**/*.jpeg
imagenes/**/*.jpg
imagenes/**/*.png
imagenes/*.zip
