        "query": "INSERT INTO buffer_mensajes (lead_id, msg_id, texto)\nVALUES ($1, $2, $3)\nON CONFLICT (msg_id) DO NOTHING;",
        "options": {
          "queryReplacement": "={{ [$json.lead_id, $json.msg_id, $json.texto] }}"
        }
      },
